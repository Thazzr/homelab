{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "automerge": false,
  "packageRules": [
    {
      "matchPackageNames": [
        "ghcr.io/goauthentik/server"
      ],
      "groupName": "Authentik",
      "automerge": false
    },
    {
      "matchPackageNames": [
        "postgres"
      ],
      "groupName": "PostgreSQL",
      "automerge": false
    }
  ]
}